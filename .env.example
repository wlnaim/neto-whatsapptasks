# Copia este archivo con el nombre ".env" y cambia los dos valores.
# El archivo ".env" es privado: NUNCA lo subas a GitHub (ya esta en .gitignore).

# Tu clave de Evolution (la inventas tu; funciona como contrasena de la API).
# Genera una aleatoria como explica el README. Mientras mas larga, mejor.
EVOLUTION_API_KEY=cambia-esto-por-una-clave-larga-y-secreta

# Contrasena de la base de datos interna. Usa SOLO letras y numeros (sin simbolos ni espacios).
EVOLUTION_DB_PASSWORD=CambiaEstoPorUnaContrasenaLargaSoloLetrasYNumeros123
